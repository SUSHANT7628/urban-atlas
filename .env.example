# First admin account, created on start-up only when data/users.json has no users yet.
ATLAS_ADMIN_USER=admin
ATLAS_ADMIN_PASSWORD=change-me-to-a-strong-password

# Signs session cookies. Any long random string; keep it secret and stable.
ATLAS_SECRET_KEY=replace-with-a-long-random-string

# true = anyone can view without signing in (changes still need an admin).
ATLAS_PUBLIC_READ=false

# true when the site is served over HTTPS (recommended in production).
ATLAS_COOKIE_SECURE=false

# Hours before a sign-in expires.
ATLAS_SESSION_HOURS=12
